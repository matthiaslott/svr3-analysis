              case Using_OutFacts_case_53
              by sorry
            qed
          qed
        next
          case evaluate_client_case_2
          by sorry
        qed
      qed
    next
      case evaluate_finish_case_2
      by sorry /* removed */
    next
      case evaluate_finish_case_3
      by sorry
    next
      case evaluate_finish_case_4
      by sorry
    qed
  qed
qed

lemma input_secrecy:
  all-traces
  "∀ C S1 S2 Gx y #i.
    (ClientInitialise( C, S1, S2, Gx, y ) @ #i) ⇒
    (¬(∃ #j. !KU( Gx ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C S1 S2 Gx y #i.
  (ClientInitialise( C, S1, S2, Gx, y ) @ #i)
 ∧
  ∃ #j. (!KU( Gx ) @ #j)"
*/
by sorry









