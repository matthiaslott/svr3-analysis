theory TOPRF begin

// Function signature and definition of the equational theory E

builtins: DH-multiplication
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2









rule (modulo E) init_client:
   [ FrDH( Fe ), FrDH( Fkoprf1 ), FrDH( Fkoprf2 ) ]
  --[
  ClientInitialise( dhExp(P'g', Fe),
                    dhExp(dhExp(dhExp(P'g', Fe), Fkoprf1), Fkoprf2)
  )
  ]->
   [ !ClientInit( dhExp(P'g', Fe) ), Out( Fkoprf1 ), Out( Fkoprf2 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_server:
   [ In( Fkoprfi ) ] --> [ !Initialised( Fkoprfi ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_client:
   [ !ClientInit( dhExp(P'g', Ee) ), FrDH( Fb ) ]
  --[ ClientEvaluate( dhExp(P'g', Ee) ) ]->
   [
   ClientEval( dhExp(P'g', Ee), Fb ),
   Out( dhExp(dhExp(P'g', Ee), Fb) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_server:
   [ In( dhExp(P'g', Ee) ), !Initialised( Fkoprfi ) ]
  -->
   [ Out( dhExp(dhExp(P'g', Ee), Fkoprfi) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_finish:
   [
   ClientEval( dhExp(P'g', Ee), Fb ), In( dhExp(P'g', Epart1) ),
   In( dhExp(P'g', Epart2) )
   ]
  --[
  ClientFinish( dhExp(P'g', Ee),
                dhExp(dhMult(dhExp(P'g', Epart1), dhExp(P'g', Epart2)), dhInv(Fb))
  )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executability:
  exists-trace
  "(((∀ Gx1 Gy1 Gx2 Gy2 #i #j.
       ((ClientInitialise( Gx1, Gy1 ) @ #i) ∧
        (ClientInitialise( Gx2, Gy2 ) @ #j)) ⇒
       (#i = #j)) ∧
     (∀ Gx1 Gx2 #i #j.
       ((ClientEvaluate( Gx1 ) @ #i) ∧ (ClientEvaluate( Gx2 ) @ #j)) ⇒
       (#i = #j))) ∧
    (∀ Gx1 Gy1 Gx2 Gy2 #i #j.
      ((ClientFinish( Gx1, Gy1 ) @ #i) ∧
       (ClientFinish( Gx2, Gy2 ) @ #j)) ⇒
      (#i = #j))) ∧
   (∃ Gx Gy #i #j #k.
     ((ClientInitialise( Gx, Gy ) @ #i) ∧ (ClientEvaluate( Gx ) @ #j)) ∧
     (ClientFinish( Gx, Gy ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"(∀ Gx1 Gy1 Gx2 Gy2 #i #j.
   (ClientInitialise( Gx1, Gy1 ) @ #i) ∧
   (ClientInitialise( Gx2, Gy2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ Gx1 Gx2 #i #j.
   (ClientEvaluate( Gx1 ) @ #i) ∧ (ClientEvaluate( Gx2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ Gx1 Gy1 Gx2 Gy2 #i #j.
   (ClientFinish( Gx1, Gy1 ) @ #i) ∧ (ClientFinish( Gx2, Gy2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∃ Gx Gy #i #j #k.
   (ClientInitialise( Gx, Gy ) @ #i) ∧
   (ClientEvaluate( Gx ) @ #j) ∧
   (ClientFinish( Gx, Gy ) @ #k))"
*/
simplify
solve( ClientInitialise( Gx, Gy ) @ #i )
  case init_client
  solve( ClientEvaluate( dhExp(P'g', Fe) ) @ #j )
    case evaluate_client
    solve( ClientFinish( dhExp(P'g', Fe),
                         dhExp(P'g', dhTimesE(Fe, dhTimesE(Fkoprf1, Fkoprf2)))
           ) @ #k )
      case evaluate_finish_case_1
      solve( !ClientInit( dhExp(P'g', Fe) ) ▶₀ #j )
        case init_client
        solve( ClientEval( dhExp(P'g', Fe), Fb.1 ) ▶₀ #k )
          case evaluate_client_case_1
          solve( !KU( dhMult(dhExp(P'g', Evy),
                             dhExp(P'g', dhTimesE(Fe, dhTimesE(Fkoprf1, Fkoprf2))))
                 ) @ #vk )
            case coerce
            solve( !KD( dhMult(dhExp(P'g', Evy),
                               dhExp(P'g', dhTimesE(Fe, dhTimesE(Fkoprf1, Fkoprf2))))
                   ) ▶₀ #vk )
              case Using_OutFacts_case_01
              by sorry
            next
              case Using_OutFacts_case_02
              by sorry
            next
              case Using_OutFacts_case_03
              by sorry
            next
              case Using_OutFacts_case_04
              by sorry
            next
              case Using_OutFacts_case_05
              by sorry
            next
              case Using_OutFacts_case_06
              by sorry
