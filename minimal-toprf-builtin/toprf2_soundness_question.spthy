theory TOPRF begin

// Function signature and definition of the equational theory E

builtins: DH-multiplication
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2









predicate: DISTINCT( x, y )<=>¬(x = y)

rule (modulo E) compromise:
   [ !Initialised( $C, $Si, koprfi ) ]
  --[ Compromised( $Si ), AdversaryAction( ) ]->
   [ Out( koprfi ) ]

  /* has exactly the trivial AC variant */

restriction Restr_init_client_1:
  "∀ x #NOW x.1.
    (Restr_init_client_1( x, x.1 ) @ #NOW) ⇒ (¬(x = x.1))"
  // safety formula

rule (modulo E) init_client:
   [ FrDH( Fe ), FrDH( Fkoprf1 ), FrDH( Fkoprf2 ) ]
  --[
  ClientInitialise( $C, $S1, $S2, dhExp(P'g', Fe),
                    h(<dhExp(P'g', Fe), 
                       dhMult(dhExp(dhExp(P'g', Fe), Fkoprf1),
                              dhExp(dhExp(P'g', Fe), Fkoprf2))
                      >)
  ),
  Restr_init_client_1( $S1, $S2 )
  ]->
   [
   !ClientInit( $C, $S1, $S2, dhExp(P'g', Fe) ),
   Out( <$C, $S1, Fkoprf1> ), Out( <$C, $S2, Fkoprf2> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) init_server:
   [ In( <$C, $Si, Fkoprfi> ) ]
  -->
   [ !Initialised( $C, $Si, Fkoprfi ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_client:
   [ !ClientInit( $C, $S1, $S2, dhExp(P'g', Ee) ), FrDH( Fb ) ]
  --[ ClientEvaluate( $C, $S1, $S2, dhExp(P'g', Ee) ) ]->
   [
   ClientEval( $C, $S1, $S2, dhExp(P'g', Ee), Fb ),
   Out( <$C, $S1, dhExp(dhExp(P'g', Ee), Fb)> ),
   Out( <$C, $S2, dhExp(dhExp(P'g', Ee), Fb)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_server:
   [
   In( <$C, $Si, dhExp(P'g', Ee)> ), !Initialised( $C, $Si, Fkoprfi )
   ]
  --[ ServerEval( ) ]->
   [ Out( <$C, $Si, dhExp(dhExp(P'g', Ee), Fkoprfi)> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) evaluate_finish:
   [
   ClientEval( $C, $S1, $S2, dhExp(P'g', Ee), Fb ),
   In( <$C, $S1, dhExp(P'g', Epart1)> ),
   In( <$C, $S2, dhExp(P'g', Epart2)> )
   ]
  --[
  ClientFinish( $C, $S1, $S2, dhExp(P'g', Ee),
                h(<dhExp(P'g', Ee), 
                   dhExp(dhMult(dhExp(P'g', Epart1), dhExp(P'g', Epart2)), dhInv(Fb))
                  >)
  ),
  ExecutabilityHelper( dhExp(P'g', Epart1), dhExp(P'g', Epart2) )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executability:
  exists-trace
  "((((¬(∃ #i. AdversaryAction( ) @ #i)) ∧
      (∀ C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j.
        ((ClientInitialise( C1a, S1a, S2a, Gxa, ya ) @ #i) ∧
         (ClientInitialise( C1b, S1b, S2b, Gxb, yb ) @ #j)) ⇒
        (#i = #j))) ∧
     (∀ C1a S1a S2a Gxa C1b S1b S2b Gxb #i #j.
       ((ClientEvaluate( C1a, S1a, S2a, Gxa ) @ #i) ∧
        (ClientEvaluate( C1b, S1b, S2b, Gxb ) @ #j)) ⇒
       (#i = #j))) ∧
    (∀ C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j.
      ((ClientFinish( C1a, S1a, S2a, Gxa, ya ) @ #i) ∧
       (ClientFinish( C1b, S1b, S2b, Gxb, yb ) @ #j)) ⇒
      (#i = #j))) ∧
   (∃ C S1 S2 Gx y Fb Fkoprf1 Fkoprf2 #i #j #k.
     (((ClientInitialise( C, S1, S2, Gx, y ) @ #i) ∧
       (ClientEvaluate( C, S1, S2, Gx ) @ #j)) ∧
      (ClientFinish( C, S1, S2, Gx, y ) @ #k)) ∧
     (ExecutabilityHelper( dhExp(dhExp(Gx, Fkoprf1), Fb),
                           dhExp(dhExp(Gx, Fkoprf2), Fb)
      ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #i. (AdversaryAction( ) @ #i) ⇒ ⊥) ∧
 (∀ C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j.
   (ClientInitialise( C1a, S1a, S2a, Gxa, ya ) @ #i) ∧
   (ClientInitialise( C1b, S1b, S2b, Gxb, yb ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ C1a S1a S2a Gxa C1b S1b S2b Gxb #i #j.
   (ClientEvaluate( C1a, S1a, S2a, Gxa ) @ #i) ∧
   (ClientEvaluate( C1b, S1b, S2b, Gxb ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j.
   (ClientFinish( C1a, S1a, S2a, Gxa, ya ) @ #i) ∧
   (ClientFinish( C1b, S1b, S2b, Gxb, yb ) @ #j)
  ⇒
   #i = #j) ∧
 (∃ C S1 S2 Gx y Fb Fkoprf1 Fkoprf2 #i #j #k.
   (ClientInitialise( C, S1, S2, Gx, y ) @ #i) ∧
   (ClientEvaluate( C, S1, S2, Gx ) @ #j) ∧
   (ClientFinish( C, S1, S2, Gx, y ) @ #k) ∧
   (ExecutabilityHelper( dhExp(dhExp(Gx, Fkoprf1), Fb),
                         dhExp(dhExp(Gx, Fkoprf2), Fb)
    ) @ #k))"
*/
simplify
solve( ClientInitialise( C, S1, S2, Gx, y ) @ #i )
  case init_client
  solve( ClientEvaluate( $C, $S1, $S2, dhExp(P'g', Fe) ) @ #j )
    case evaluate_client
    solve( ClientFinish( $C, $S1, $S2, dhExp(P'g', Fe),
                         h(<dhExp(P'g', Fe), 
                            dhMult(dhExp(P'g', dhTimesE(Fe, Fkoprf1)),
                                   dhExp(P'g', dhTimesE(Fe, Fkoprf2)))
                           >)
           ) @ #k )
      case evaluate_finish_case_1
      solve( ExecutabilityHelper( dhExp(P'g',
                                        dhTimesE(Fe, dhTimesE(Fkoprf1.2, Fb.3))),
                                  dhExp(P'g', dhTimesE(Fe, dhTimesE(Fkoprf2.2, Fb.3)))
             ) @ #k )
        case evaluate_finish
        solve( !ClientInit( $C, $S1, $S2, dhExp(P'g', Fe) ) ▶₀ #j )
          case init_client
          solve( ClientEval( $C, $S1, $S2, dhExp(P'g', Fe), Fb.1 ) ▶₀ #k )
            case evaluate_client_case_1
            solve( !KU( dhExp(P'g', dhTimesE(Fkoprf1, dhTimesE(Fb, Fe)))
                   ) @ #vk.5 )
              case coerce
              solve( !KD( dhExp(P'g', dhTimesE(Fkoprf1, dhTimesE(Fb, Fe)))
                     ) ▶₀ #vk )
                case Using_OutFacts_case_1
                solve( !KU( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                       ) @ #vk.8 )
                  case coerce
                  solve( !KD( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                         ) ▶₀ #vk.1 )
                    case Using_OutFacts_case_1
                    SOLVED // trace found
                  next
                    case Using_OutFacts_case_2
                    SOLVED // trace found
                  next
                    case Using_OutFacts_case_3
                    solve( !Initialised( $C.1, $Si, Fe ) ▶₁ #vr )
                      case init_server
                      by contradiction /* adversary derived secret element! */
                    qed
                  next
                    case Using_OutFacts_case_4
                    solve( !Initialised( $C.1, $Si, Fb ) ▶₁ #vr )
                      case init_server
                      by contradiction /* adversary derived secret element! */
                    qed
                  qed
                qed
              next
                case Using_OutFacts_case_2
                solve( !KU( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                       ) @ #vk.8 )
                  case coerce
                  solve( !KD( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                         ) ▶₀ #vk.1 )
                    case Using_OutFacts_case_1
                    SOLVED // trace found
                  next
                    case Using_OutFacts_case_2
                    SOLVED // trace found
                  next
                    case Using_OutFacts_case_3
                    solve( !Initialised( $C.1, $Si, Fe ) ▶₁ #vr )
                      case init_server
                      by contradiction /* adversary derived secret element! */
                    qed
                  next
                    case Using_OutFacts_case_4
                    solve( !Initialised( $C.1, $Si, Fb ) ▶₁ #vr )
                      case init_server
                      by contradiction /* adversary derived secret element! */
                    qed
                  qed
                qed
              next
                case Using_OutFacts_case_3
                solve( !Initialised( $C.1, $Si, Fe ) ▶₁ #vr )
                  case init_server
                  by contradiction /* adversary derived secret element! */
                qed
              next
                case Using_OutFacts_case_4
                solve( !Initialised( $C.1, $Si, Fb ) ▶₁ #vr )
                  case init_server
                  by contradiction /* adversary derived secret element! */
                qed
              qed
            qed
          next
            case evaluate_client_case_2
            solve( !KU( dhExp(P'g', dhTimesE(Fkoprf1, dhTimesE(Fb, Fe)))
                   ) @ #vk.5 )
              case coerce
              solve( !KD( dhExp(P'g', dhTimesE(Fkoprf1, dhTimesE(Fb, Fe)))
                     ) ▶₀ #vk )
                case Using_OutFacts_case_1
                solve( !KU( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                       ) @ #vk.8 )
                  case coerce
                  solve( !KD( dhExp(P'g', dhTimesE(Fb, dhTimesE(Fe, Fkoprf2)))
                         ) ▶₀ #vk.1 )
                    case Using_OutFacts_case_1
                    SOLVED // trace found
