theory TOPRF

begin

builtins: hashing, DH-multiplication

predicates:
    DISTINCT(x, y) <=> not (x = y)

// Server Compromise

rule compromise:
    [ !Initialised($C, $Si, koprfi) ]
  --[ Compromised($Si)
    , AdversaryAction() ]->
    [ Out(koprfi) ]


// TOPRF

// Assumptions:
// - Client remembers with which servers it initialised
// - Use a slightly abnormal setup where the TOPRF input x is already known during initialisation (like in SVR3). 

// Initialisation
rule init_client:
    let
      x = dhExp(P'g', Fe)
      temp = dhExp(dhExp(x, Fkoprf1), Fkoprf2)
      y = h(<x, temp>)
    in
    [ FrDH(Fe), FrDH(Fkoprf1), FrDH(Fkoprf2) ]
  --[ _restrict(DISTINCT($S1, $S2))
    , ClientInitialise($C, $S1, $S2, x, y) ]->
    [ !ClientInit($C, $S1, $S2, x), Out(<$C, $S1, Fkoprf1>), Out(<$C, $S2, Fkoprf2>) ]

rule init_server:
    // TODO: Consider not requiring a FRNZE koprfi here.
    // - Problem 1: The adversary might actually send a zero exponent.
    // - Problem 2: The adversary might actually send a composite exponent or one that is the inverse of another.
    [ In(<$C, $Si, Fkoprfi>) ]
  --[ ]->
    [ !Initialised($C, $Si, Fkoprfi) ]


// Evaluation
rule evaluate_client:
    let
      x = dhExp(P'g', Ee)
      blinded_hash = dhExp(x, Fb)
    in
    [ !ClientInit($C, $S1, $S2, x), FrDH(Fb) ]
  --[ ClientEvaluate($C, $S1, $S2, x) ]->
    [ ClientEval($C, $S1, $S2, x, Fb), Out(<$C, $S1, blinded_hash>), Out(<$C, $S2, blinded_hash>) ]

rule evaluate_server:
    let
      blinded_hash = dhExp(P'g', Ee)
    in
    [ In(<$C, $Si, blinded_hash>), !Initialised($C, $Si, Fkoprfi) ]
  --[ ServerEval() ]->
    [ Out(<$C, $Si, dhExp(blinded_hash, Fkoprfi)>) ]
  
rule evaluate_finish:
    let
      part1 = dhExp(P'g', Epart1)
      part2 = dhExp(P'g', Epart2)
      temp = dhExp(dhMult(part1, part2), dhInv(Fb))
      x = dhExp(P'g', Ee)
      y = h(<x, temp>)
    in
    [ ClientEval($C, $S1, $S2, x, Fb), In(<$C, $S1, part1>), In(<$C, $S2, part2>) ]
  --[ ClientFinish($C, $S1, $S2, x, y) ]->
    [ ]


lemma executability:
    exists-trace "
      // adversary doesn't do anything
      not (Ex #i. AdversaryAction()@#i)
      &
      // remove some case distinctions early
      (All C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j. ClientInitialise(C1a, S1a, S2a, Gxa, ya)@#i & ClientInitialise(C1b, S1b, S2b, Gxb, yb)@#j ==> #i = #j)
      &
      (All C1a S1a S2a Gxa C1b S1b S2b Gxb #i #j. ClientEvaluate(C1a, S1a, S2a, Gxa)@#i & ClientEvaluate(C1b, S1b, S2b, Gxb)@#j ==> #i = #j)
      &
      (All C1a S1a S2a Gxa ya C1b S1b S2b Gxb yb #i #j. ClientFinish(C1a, S1a, S2a, Gxa, ya)@#i & ClientFinish(C1b, S1b, S2b, Gxb, yb)@#j ==> #i = #j)
      &
      ( Ex C S1 S2 Gx y #i #j #k.
          ( ClientInitialise(C, S1, S2, Gx, y)@#i
          & ClientEvaluate(C, S1, S2, Gx)@#j
          & ClientFinish(C, S1, S2, Gx, y)@#k
        )
      )
    "
  
//lemma input_secrecy[heuristic={input_secrecy}]:
lemma input_secrecy:
    "All C S1 S2 Gx y #i.
      ClientInitialise(C, S1, S2, Gx, y)@#i
        ==> (not Ex #j. KU(Gx)@#j)
    "

end