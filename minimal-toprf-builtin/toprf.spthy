theory TOPRF

begin

builtins: hashing, DH-multiplication

predicates:
    DISTINCT(x, y, z) <=> not (x = y | x = z | y = z)

// Server Compromise

rule compromise:
    [ !Initialised($C, $Si, koprfi) ]
  --[ Compromised($Si)
    , AdversaryAction() ]->
    [ Out(koprfi) ]


// TOPRF

// Assumptions:
// - Client remembers with which servers it initialised
// - Use a slightly abnormal setup where the TOPRF input x is already known during initialisation (like in SVR3). 

// Initialisation
rule init_client:
    let
      x = dhExp(P'g', Fe)
      temp = dhExp(dhExp(dhExp(x, Fkoprf1), Fkoprf2), Fkoprf3)
      y = h(<x, temp>)
    in
    [ FrDH(Fe), FrDH(Fkoprf1), FrDH(Fkoprf2), FrDH(Fkoprf3) ]
  --[ _restrict(DISTINCT($S1, $S2, $S3))
    , ClientInitialise($C, $S1, $S2, $S3, x, y) ]->
    [ !ClientInit($C, $S1, $S2, $S3, x), Out(<$C, $S1, Fkoprf1>), Out(<$C, $S2, Fkoprf2>), Out(<$C, $S3, Fkoprf3>) ]

rule init_server:
    // TODO: Consider not requiring a FRNZE koprfi here.
    // - Problem 1: The adversary might actually send a zero exponent.
    // - Problem 2: The adversary might actually send a composite exponent or one that is the inverse of another.
    [ In(<$C, $Si, Fkoprfi>) ]
  --[ ]->
    [ !Initialised($C, $Si, Fkoprfi) ]


// Evaluation
rule evaluate_client:
    let
      x = dhExp(P'g', Ee)
      blinded_hash = dhExp(x, Fb)
    in
    [ !ClientInit($C, $S1, $S2, $S3, x), FrDH(Fb) ]
  --[ ClientEvaluate($C, $S1, $S2, $S3, x) ]->
    [ ClientEval($C, $S1, $S2, $S3, x, Fb), Out(<$C, $S1, blinded_hash>), Out(<$C, $S2, blinded_hash>), Out(<$C, $S3, blinded_hash>) ]

rule evaluate_server:
    let
      blinded_hash = dhExp(P'g', Ee)
    in
    [ In(<$C, $Si, blinded_hash>), !Initialised($C, $Si, Fkoprfi) ]
  --[ ServerEval($C, $Si) ]->
    [ Out(<$C, $Si, dhExp(blinded_hash, Fkoprfi)>) ]
  
rule evaluate_finish:
    let
      part1 = dhExp(P'g', Epart1)
      part2 = dhExp(P'g', Epart2)
      part3 = dhExp(P'g', Epart3)
      temp = dhExp(dhMult(dhMult(part1, part2), part3), dhInv(Fb))
      x = dhExp(P'g', Ee)
      y = h(<x, temp>)
    in
    [ ClientEval($C, $S1, $S2, $S3, x, Fb), In(<$C, $S1, part1>), In(<$C, $S2, part2>), In(<$C, $S3, part3>) ]
  --[ ClientFinish($C, $S1, $S2, $S3, x, y) ]->
    [ ]


/*lemma types[sources,heuristic={sources}]:
    "(All p #i.
      SourcesPoint(p)@#i
      ==>
      ( (Ex #j. SourceP(p)@#j & #j < #i)
      | (Ex #j. !KU(p)@#j & #j < #i)
      )
    )"*/


lemma executability:
    exists-trace "
      // adversary doesn't do anything
      not (Ex #i. AdversaryAction()@#i)
      &
      ( Ex C S1 S2 S3 Gx y #i #j.
          ( ClientInitialise(C, S1, S2, S3, Gx, y)@#i
          & ClientFinish(C, S1, S2, S3, Gx, y)@#j
        )
      )
    "

/*lemma mul_invariant[reuse,use_induction,heuristic={mul_invariant}]:
    "All f x #i. KMul(mul(f, h(x)))@#i // & (Ex #j. !HumanGenerated(pw)@#j) // If multiplication with a password hash on the right side, then
      ==> (Ex #k. BlindingFactor(f)@#k) // f contains a secret factor
      | (Ex a b #k. BlindingFactor(b)@#k & f = a ++ b) // f contains a secret factor
      | (Ex #k. !KU(x)@#k & #k < #i)" // don't want to deal with the case where adversary knows the password already*/
  
//lemma input_secrecy[heuristic={input_secrecy}]:
lemma input_secrecy:
    "All C S1 S2 S3 Gx y #i.
      ClientInitialise(C, S1, S2, S3, Gx, y)@#i
        ==> (not Ex #j. KU(Gx)@#j)
    "

end