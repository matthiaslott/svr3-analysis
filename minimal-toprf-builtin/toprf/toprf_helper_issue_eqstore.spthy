lemma input_secrecy:
  all-traces
  "∀ C S1 S2 S3 Gx y #i.
    (ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i) ⇒
    (¬(∃ #j. !KU( Gx ) @ #j))"
