theory TOPRF

begin

builtins: hashing, DH-multiplication

// Assumptions:
// - Use a slightly abnormal setup where the TOPRF input x is already known during initialisation (like in SVR3). 

// Initialisation
rule init_client:
    let
      x = dhExp(P'g', Fe)
      y = dhExp(dhExp(x, Fkoprf1), Fkoprf2)
    in
    [ FrDH(Fe), FrDH(Fkoprf1), FrDH(Fkoprf2) ]
  --[ ClientInitialise(x, y) ]->
    [ !ClientInit(x), !Initialised(Fkoprf1), !Initialised(Fkoprf2) ]

// Evaluation
rule evaluate_client:
    let
      x = dhExp(P'g', Ee)
      blinded_hash = dhExp(x, Fb)
    in
    [ !ClientInit(x), FrDH(Fb) ]
  --[ ClientEvaluate(x, blinded_hash) ]->
    [ ClientEval(x, Fb), Out(blinded_hash) ]

rule evaluate_server:
    let
      blinded_hash = dhExp(P'g', Ee)
    in
    [ In(blinded_hash), !Initialised(Fkoprfi) ]
  --[ ServerEval(blinded_hash) ]->
    [ Out(dhExp(blinded_hash, Fkoprfi)) ]
  
rule evaluate_finish:
    let
      part1 = dhExp(P'g', Epart1)
      part2 = dhExp(P'g', Epart2)
      y = dhExp(dhMult(part1, part2), dhInv(Fb))
      x = dhExp(P'g', Ee)
    in
    [ ClientEval(x, Fb), In(part1), In(part2) ]
  --[ ClientFinish(x, y) ]->
    [ ]


lemma executability:
    exists-trace "
      // ensure that Init, Eval and Finish only happen once
      ( All Gx1 Gy1 Gx2 Gy2 #i #j. ClientInitialise(Gx1, Gy1)@#i & ClientInitialise(Gx2, Gy2)@#j ==> #i = #j)
      &
      ( All Gx1 Gh1 Gx2 Gh2 #i #j. ClientEvaluate(Gx1, Gh1)@#i & ClientEvaluate(Gx2, Gh2)@#j ==> #i = #j)
      &
      ( All Gx1 Gy1 Gx2 Gy2 #i #j. ClientFinish(Gx1, Gy1)@#i & ClientFinish(Gx2, Gy2)@#j ==> #i = #j)
      &
      // trying to ensure that server receives the output from the client (doesn't seem to work, Tamarin isn't resolving the equation eagerly)
      ( All Gh1 Gh2 Gx #i #j. ServerEval(Gh1)@#i & ClientEvaluate(Gx, Gh2)@#j ==> Gh1 = Gh2)
      &
      // remove some case distinctions early
      ( Ex Gx Gy Gh #i #j #k.
          ( ClientInitialise(Gx, Gy)@#i
          & ClientEvaluate(Gx, Gh)@#j
          & ClientFinish(Gx, Gy)@#k
        )
      )
    "

end