lemma input_secrecy:
  all-traces
  "∀ C S1 S2 S3 Gx y #i.
    (ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i) ⇒
    (¬(∃ #j. !KU( Gx ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C S1 S2 S3 Gx y #i.
  (ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i)
 ∧
  ∃ #j. (!KU( Gx ) @ #j)"
*/
simplify
solve( ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i )
  case client_init
  solve( !KU( dhExp(P'g', Fe) ) @ #j )
    case coerce
    solve( !KD( dhExp(P'g', Fe) ) ▶₀ #j )
      case Using_OutFacts_case_1
      by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
    next
      case Using_OutFacts_case_2
      by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
    next
      case Using_OutFacts_case_3
      by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
    next
      case Using_OutFacts_case_4
      by solve( !Keyshare( $C.1, $Si, Fe ) ▶₁ #vr )
    next
      case Using_OutFacts_case_5
      by solve( !Keyshare( $C.1, $Si, Fe ) ▶₁ #vr )
    next
      case Using_OutFacts_case_6
      by solve( !Keyshare( $C.1, $Si, Fe ) ▶₀ #vr )
    qed
  qed
qed

lemma output_secrecy:
  all-traces
  "∀ C S1 S2 S3 Gx y #i.
    (ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i) ⇒
    (¬(∃ #j. !KU( y ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C S1 S2 S3 Gx y #i.
  (ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i)
 ∧
  ∃ #j. (!KU( y ) @ #j)"
*/
simplify
solve( ClientInitialise( C, S1, S2, S3, Gx, y ) @ #i )
  case client_init
  solve( !KU( h(<dhExp(P'g', Fe), 
                 dhMult(dhExp(P'g', dhTimesE(Fe, Fkoprf1)),
                        dhMult(dhExp(P'g', dhTimesE(Fe, Fkoprf2)),
                               dhExp(P'g', dhTimesE(Fe, Fkoprf3))))
                >)
         ) @ #j )
    case c_h
    solve( !KU( dhExp(P'g', Fe) ) @ #vk.1 )
      case coerce
      solve( !KD( dhExp(P'g', Fe) ) ▶₀ #vk )
        case Using_OutFacts_case_1
        by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
      next
        case Using_OutFacts_case_2
        by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
      next
        case Using_OutFacts_case_3
        by solve( !Keyshare( $C.2, $Si, Fb ) ▶₀ #vr.1 )
      next
        case Using_OutFacts_case_4
        by solve( !Keyshare( $C.1, $Si, Fe ) ▶₁ #vr )
      next
        case Using_OutFacts_case_5
        by solve( !Keyshare( $C.1, $Si, Fe ) ▶₁ #vr )
      next
        case Using_OutFacts_case_6
        by solve( !Keyshare( $C.1, $Si, Fe ) ▶₀ #vr )
      qed
    qed
  next
    case coerce
    solve( !KD( h(<dhExp(P'g', Fe), 
                   dhMult(dhExp(P'g', dhTimesE(Fe, Fkoprf1)),
                          dhMult(dhExp(P'g', dhTimesE(Fe, Fkoprf2)),
                                 dhExp(P'g', dhTimesE(Fe, Fkoprf3))))
                  >)
           ) ▶₀ #j )
      case client_eval_case_1
      by contradiction /* impossible chain */
    next
      case client_eval_case_2
      by contradiction /* impossible chain */
    next
      case client_eval_case_3
      by contradiction /* impossible chain */
    next
      case compromise
      by contradiction /* impossible chain */
    next
      case freshNZE
      by contradiction /* cyclic */
    next
      case pubGConstr_case_1
      by contradiction /* forbidden KD-fact */
    next
      case pubGConstr_case_2
      by contradiction /* forbidden KD-fact */
    next
      case pubGConstr_case_3
      by contradiction /* cyclic */
    next
      case server_eval
      solve( (#vl, 0) ~~> (#j, 0) )
        case d_0_fst
        by contradiction /* cyclic */
      next
        case d_0_snd
        solve( (#vr.1, 0) ~~> (#j, 0) )
          case d_0_fst
          by contradiction /* cyclic */
        next
          case d_0_snd
          by solve( (#vr.2, 0) ~~> (#j, 0) )
        qed
      qed
    qed
  qed
qed

lemma keyshare_secrecy:
  all-traces
  "∀ C Si Fkoprfi #i.
    (!Keyshare( C, Si, Fkoprfi ) @ #i) ⇒
    ((¬(∃ #j. !KU( Fkoprfi ) @ #j)) ∨ (∃ #j. Compromised( Si ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C Si Fkoprfi #i.
  (!Keyshare( C, Si, Fkoprfi ) @ #i)
 ∧
  (∃ #j. (!KU( Fkoprfi ) @ #j)) ∧
  (∀ #j. (Compromised( Si ) @ #j) ⇒ ⊥)"
*/
simplify
solve( !Keyshare( C, Si, Fkoprfi ) @ #i )
  case client_init_case_1
  solve( !KU( Fkoprfi ) @ #j )
    case compromise
    solve( !Keyshare( $C.1, $Si, Fkoprfi ) ▶₀ #vr )
      case client_init
      by contradiction /* from formulas */
    qed
  qed
next
  case client_init_case_2
  solve( !KU( Fkoprfi ) @ #j )
    case compromise
    solve( !Keyshare( $C.1, $Si, Fkoprfi ) ▶₀ #vr )
      case client_init
      by contradiction /* from formulas */
    qed
  qed
next
  case client_init_case_3
  solve( !KU( Fkoprfi ) @ #j )
    case compromise
    solve( !Keyshare( $C.1, $Si, Fkoprfi ) ▶₀ #vr )
      case client_init
      by contradiction /* from formulas */
    qed
  qed
qed

lemma res_secrecy:
  all-traces
  "∀ C S1 S2 S3 Gx Gres #i.
    (ClientInitialise( C, S1, S2, S3, Gx, h(<Gx, Gres>) ) @ #i) ⇒
    (¬(∃ #j. !KU( Gres ) @ #j))"
/*
