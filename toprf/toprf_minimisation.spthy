theory toprf_minimisation

begin

builtins: diffie-hellman

rule client_init:
    [ Fr(~e), Fr(~b) ]
  --[ SecretExp(~e, 'g'^~e), BlindingExp(~b) ]->
    [ Out('g'^~e^~b) ]

rule exp:
    [ Fr(~y) ]-->[ !Exp(~y) ]

rule server:
    [ In('g'^x), !Exp(~y) ]
  --[ ServerExp(x*~y) ]->
    [ Out('g'^x^~y) ]

lemma ordering[reuse]:
    "All e ge r1 t #i #j. SecretExp(e, ge)@#i & ServerExp(t)@#j & t = e * r1
      ==>
        #i < #j
    "

lemma blinding[reuse]:
    "All e ge r1 t #i #j. SecretExp(e, ge)@#i & ServerExp(t)@#j & t = e * r1
      ==>
        ( Ex b r2 #k. BlindingExp(b)@#k & t = b * r2 )
      | ( Ex #k. !KU(ge)@#k & #k < #j )
    "


lemma secrecy_no_lemma[hide_lemma=blinding,hide_lemma=ordering]:
    "All e ge #i. SecretExp(e, ge)@#i ==> not (Ex #k. !KU(ge)@#k)"

lemma secrecy_lemma:
    "All e ge #i. SecretExp(e, ge)@#i ==> not (Ex #k. !KU(ge)@#k)"

end

