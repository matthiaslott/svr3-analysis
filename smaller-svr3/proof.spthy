                                    case add_case_1
                                    solve( !Bruteforce( ~pw, ~pw ) ▶₀ #vr.24 )
                                      case bruteforce_hg
                                      solve( !MulU( mul(~koprf3, h(~pw)) ) ▶₂ #vr.25 )
                                        case mul_coerce_case_1
                                        solve( !KU( h(~pw) ) @ #vk.7 )
                                          case c_h
