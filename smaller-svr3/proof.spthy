  solve( (∀ #j. (!KU( ~pw ) @ #j) ⇒ ⊥)  ∥
         (∃ sid1 sid2 sid3 #j #k #l #m.
           (InvolvedServers( ~pw, sid1, sid2, sid3 ) @ #j) ∧
           (!Compromised( sid1 ) @ #k) ∧
           (!Compromised( sid2 ) @ #l) ∧
