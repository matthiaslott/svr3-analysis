lemma pw_pre_quantum_secrecy [reuse,
                              heuristic={pw_pre_quantum_secrecy}]:
  all-traces
  "∀ id pw #i.
    (Secret( id, 'pw', pw ) @ #i) ⇒
    (((¬(∃ #j. !KU( pw ) @ #j)) ∨
      (∃ sid1 sid2 sid3 #j #k #l #m.
        (((InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
          (!Compromised( sid1 ) @ #k)) ∧
         (!Compromised( sid2 ) @ #l)) ∧
        (!Compromised( sid3 ) @ #m))) ∨
     (∃ #j #k.
       ((!KU( pw ) @ #j) ∧ (PQAdversaryAction( ) @ #k)) ∧ (#k < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ id pw #i.
  (Secret( id, 'pw', pw ) @ #i)
 ∧
  (∃ #j. (!KU( pw ) @ #j)) ∧
  (∀ sid1 sid2 sid3 #j #k #l #m.
    (InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
    (!Compromised( sid1 ) @ #k) ∧
    (!Compromised( sid2 ) @ #l) ∧
    (!Compromised( sid3 ) @ #m)
   ⇒
    ⊥) ∧
  (∀ #j #k.
    (!KU( pw ) @ #j) ∧ (PQAdversaryAction( ) @ #k) ⇒ ¬(#k < #j))"
*/
simplify
solve( Secret( id, 'pw', pw ) @ #i )
  case client_register
  solve( Client_0( $cid, ~pw ) ▶₀ #i )
    case client_initialise
    solve( !Server( $sid1 ) ▶₄ #i )
      case create_server
      solve( !Server( $sid2 ) ▶₅ #i )
        case create_server
        solve( !Server( $sid3 ) ▶₆ #i )
          case create_server
          solve( !KU( ~pw ) @ #j )
            case bruteforce
            solve( (∀ #j. (!HumanGenerated( ~pw.1 ) @ #j) ⇒ ⊥)  ∥
                   (∃ #k. (BlindingFactor( ~b ) @ #k))  ∥
                   (∃ a b.1 #k. (BlindingFactor( b.1 ) @ #k) ∧ (~b = (a++b.1)))  ∥
                   (∃ #k. (PQAdversaryAction( ) @ #k) ∧ #k < #vr.5)  ∥
                   (∃ #k. (!KU( ~pw.1 ) @ #k) ∧ #k < #vr.5) )
              case case_1
              by contradiction /* from formulas */
            next
              case case_2
              solve( !KU( ~b ) @ #vk )
                case solve_dlog
                by contradiction /* from formulas */
              qed
            next
              case case_4
              by contradiction /* from formulas */
            next
              case case_5
              solve( !KU( ~b ) @ #vk )
                case solve_dlog
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

