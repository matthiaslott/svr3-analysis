    (((¬(∃ #j. !KU( kauth ) @ #j)) ∨
      (∃ sid1 sid2 sid3 #j #k #l #m.
        (((InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
          (!Compromised( sid1 ) @ #k)) ∧
         (!Compromised( sid2 ) @ #l)) ∧
        (!Compromised( sid3 ) @ #m))) ∨
     (∃ #j #k.
       ((!KU( kauth ) @ #j) ∧ (PQAdversaryAction( ) @ #k)) ∧ (#k < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ id kauth #i.
  (Secret( id, 'kauth', kauth ) @ #i)
 ∧
  (∃ #j. (!KU( kauth ) @ #j)) ∧
  (∀ sid1 sid2 sid3 #j #k #l #m.
    (InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
