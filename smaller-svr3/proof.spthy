    (((¬(∃ #j. !KU( koprf ) @ #j)) ∨
      (∃ sid1 sid2 sid3 #j #k #l #m.
        (((InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
          (!Compromised( sid1 ) @ #k)) ∧
         (!Compromised( sid2 ) @ #l)) ∧
        (!Compromised( sid3 ) @ #m))) ∨
     (∃ #j #k.
       ((!KU( koprf ) @ #j) ∧ (PQAdversaryAction( ) @ #k)) ∧ (#k < #j)))"
/*
guarded formula characterizing all counter-examples:
"∃ id koprf #i.
  (Secret( id, 'koprf', koprf ) @ #i)
 ∧
  (∃ #j. (!KU( koprf ) @ #j)) ∧
  (∀ sid1 sid2 sid3 #j #k #l #m.
    (InvolvedServers( id, sid1, sid2, sid3 ) @ #j) ∧
    (!Compromised( sid1 ) @ #k) ∧
    (!Compromised( sid2 ) @ #l) ∧
    (!Compromised( sid3 ) @ #m)
   ⇒
    ⊥) ∧
  (∀ #j #k.
    (!KU( koprf ) @ #j) ∧ (PQAdversaryAction( ) @ #k) ⇒ ¬(#k < #j))"
*/
simplify
solve( Secret( id, 'koprf', koprf ) @ #i )
  case client_register
  solve( !KU( ~koprf1 ) @ #vk )
    case eavesdrop_server
    solve( !KU( ~koprf2 ) @ #vk.1 )
      case eavesdrop_server
      solve( !KU( ~koprf3 ) @ #vk.2 )
        case eavesdrop_server
