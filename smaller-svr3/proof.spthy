lemma executability:
  exists-trace
  "(((((¬(∃ #i. AdversaryAction( ) @ #i)) ∧
       (∀ cid pw1 pw2 kauth1 kauth2 #i #j.
         ((ClientRegister( cid, pw1, kauth1 ) @ #i) ∧
          (ClientRegister( cid, pw2, kauth2 ) @ #j)) ⇒
         (#i = #j))) ∧
      (∀ cid pw1 pw2 #i #j.
        ((ClientReconstruct( cid, pw1 ) @ #i) ∧
         (ClientReconstruct( cid, pw2 ) @ #j)) ⇒
        (#i = #j))) ∧
     (∀ sid #i #j.
       ((ServerReconstruct( sid ) @ #i) ∧
        (ServerReconstruct( sid ) @ #j)) ⇒
       (#i = #j))) ∧
    (∀ id sid1 sid2 sid3 #i id2 sid4 sid5 sid6 #j.
      ((InvolvedServers( id, sid1, sid2, sid3 ) @ #i) ∧
       (InvolvedServers( id2, sid4, sid5, sid6 ) @ #j)) ⇒
      ((((id = id2) ∧ (sid1 = sid4)) ∧ (sid2 = sid5)) ∧
       (sid3 = sid6)))) ∧
   (∃ cid pw kauth #i #j #k.
     ((ClientRegister( cid, pw, kauth ) @ #i) ∧
      (ClientReconstruct( cid, pw ) @ #j)) ∧
     (ClientReconstructFinish( cid, pw, kauth ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #i. (AdversaryAction( ) @ #i) ⇒ ⊥) ∧
 (∀ cid pw1 pw2 kauth1 kauth2 #i #j.
   (ClientRegister( cid, pw1, kauth1 ) @ #i) ∧
   (ClientRegister( cid, pw2, kauth2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ cid pw1 pw2 #i #j.
   (ClientReconstruct( cid, pw1 ) @ #i) ∧
   (ClientReconstruct( cid, pw2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ sid #i #j.
   (ServerReconstruct( sid ) @ #i) ∧ (ServerReconstruct( sid ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ id sid1 sid2 sid3 #i id2 sid4 sid5 sid6 #j.
   (InvolvedServers( id, sid1, sid2, sid3 ) @ #i) ∧
   (InvolvedServers( id2, sid4, sid5, sid6 ) @ #j)
  ⇒
   (id = id2) ∧ (sid1 = sid4) ∧ (sid2 = sid5) ∧ (sid3 = sid6)) ∧
 (∃ cid pw kauth #i #j #k.
   (ClientRegister( cid, pw, kauth ) @ #i) ∧
   (ClientReconstruct( cid, pw ) @ #j) ∧
   (ClientReconstructFinish( cid, pw, kauth ) @ #k))"
*/
simplify
  case 1
  solve( Client_0( $cid, ~pw ) ▶₀ #i )
    case client_initialise
    solve( !Server( $sid1 ) ▶₄ #i )
      case create_server
      solve( !Server( $sid2 ) ▶₅ #i )
        case create_server
        solve( !Server( $sid3 ) ▶₆ #i )
          case create_server
          solve( !Client_1( $cid, ~pw ) ▶₀ #j )
            case client_register
            solve( !Server( $sid1 ) ▶₂ #j )
              case create_server
              solve( !Server( $sid2 ) ▶₃ #j )
                case create_server
                solve( !Server( $sid3 ) ▶₄ #j )
                  case create_server
                  solve( Client_2( $cid, ~pw, $sid1.1, $sid2.1, $sid3.1, ~b.1
                         ) ▶₀ #k )
                    case client_reconstruct
                    solve( SCIn( $sid1, $cid, mul((~b++~koprf1), h(~pw)) ) ▶₁ #k )
                      case forward_case_1
                      by contradiction /* from formulas */
                    next
                      case forward_case_2
                      by contradiction /* from formulas */
                    next
                      case forward_case_3
                      solve( SCIn( $sid2, $cid, mul((~b++~koprf2), h(~pw)) ) ▶₂ #k )
                        case forward_case_1
                        by contradiction /* from formulas */
                      next
                        case forward_case_2
                        by contradiction /* from formulas */
                      next
                        case forward_case_3
                        solve( SCIn( $sid3, $cid, mul((~b++~koprf3), h(~pw)) ) ▶₃ #k )
                          case forward_case_1
                          by contradiction /* from formulas */
                        next
                          case forward_case_2
                          by contradiction /* from formulas */
                        next
                          case forward_case_3
                          solve( SCIn( $cid, $sid1, <$cid.1, mul(~b, h(~pw))> ) ▶₁ #vr.8 )
                            case forward_case_1
                            by contradiction /* from formulas */
                          next
                            case forward_case_2
                            by contradiction /* from formulas */
                          next
                            case forward_case_3
                            solve( SCIn( $client, $sid1, <$cid, ~koprf1> ) ▶₁ #vr.9 )
                              case forward_case_1
                              by contradiction /* from formulas */
                            next
                              case forward_case_2
                              by contradiction /* from formulas */
                            next
                              case forward_case_3
                              solve( SCIn( $cid, $sid2, <$cid.1, mul(~b, h(~pw))> ) ▶₁ #vr.12 )
                                case forward_case_1
                                by contradiction /* from formulas */
                              next
                                case forward_case_2
                                by contradiction /* from formulas */
                              next
                                case forward_case_3
                                solve( SCIn( $client, $sid2, <$cid, ~koprf2> ) ▶₁ #vr.13 )
                                  case forward_case_1
                                  by contradiction /* from formulas */
                                next
                                  case forward_case_2
                                  by contradiction /* from formulas */
                                next
                                  case forward_case_3
                                  solve( SCIn( $cid, $sid3, <$cid.1, mul(~b, h(~pw))> ) ▶₁ #vr.16 )
                                    case forward_case_1
                                    by contradiction /* from formulas */
                                  next
                                    case forward_case_2
                                    by contradiction /* from formulas */
                                  next
                                    case forward_case_3
                                    solve( SCIn( $client, $sid3, <$cid, ~koprf3> ) ▶₁ #vr.17 )
                                      case forward_case_1
                                      by contradiction /* from formulas */
                                    next
                                      case forward_case_2
                                      by contradiction /* from formulas */
                                    next
                                      case forward_case_3
                                      SOLVED // trace found
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        next
                          case forward_case_4
                          by sorry
                        qed
                      next
                        case forward_case_4
                        by sorry
                      qed
                    next
                      case forward_case_4
                      by sorry
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
next
  case 2
  by sorry
next
  case 3
  by sorry
next
  case 4
  by sorry
next
  case 5
  by sorry
next
  case 6
  by sorry
qed

lemma post_quantum_attack:
  exists-trace
  "(((∀ cid pw1 pw2 kauth1 kauth2 #i #j.
       ((ClientRegister( cid, pw1, kauth1 ) @ #i) ∧
        (ClientRegister( cid, pw2, kauth2 ) @ #j)) ⇒
       (#i = #j)) ∧
     (∀ cid pw1 pw2 #i #j.
       ((ClientReconstruct( cid, pw1 ) @ #i) ∧
        (ClientReconstruct( cid, pw2 ) @ #j)) ⇒
       (#i = #j))) ∧
    (∀ id sid1 sid2 sid3 #i id2 sid4 sid5 sid6 #j.
      ((InvolvedServers( id, sid1, sid2, sid3 ) @ #i) ∧
       (InvolvedServers( id2, sid4, sid5, sid6 ) @ #j)) ⇒
      ((((id = id2) ∧ (sid1 = sid4)) ∧ (sid2 = sid5)) ∧
       (sid3 = sid6)))) ∧
   (∃ id pw koprf kauth #i #j #k #l #m #n.
     ((((((Secret( id, 'pw', pw ) @ #i) ∧ (!KU( pw ) @ #j)) ∧
         (Secret( id, 'koprf', koprf ) @ #k)) ∧
        (!KU( koprf ) @ #l)) ∧
       (Secret( id, 'kauth', kauth ) @ #m)) ∧
      (!KU( kauth ) @ #n)) ∧
     (¬(∃ sid1 sid2 sid3 #o #p #q #r.
         (((InvolvedServers( id, sid1, sid2, sid3 ) @ #o) ∧
           (!Compromised( sid1 ) @ #p)) ∧
          (!Compromised( sid2 ) @ #q)) ∧
         (!Compromised( sid3 ) @ #r))))"
/*
guarded formula characterizing all satisfying traces:
"(∀ cid pw1 pw2 kauth1 kauth2 #i #j.
   (ClientRegister( cid, pw1, kauth1 ) @ #i) ∧
   (ClientRegister( cid, pw2, kauth2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ cid pw1 pw2 #i #j.
   (ClientReconstruct( cid, pw1 ) @ #i) ∧
   (ClientReconstruct( cid, pw2 ) @ #j)
  ⇒
   #i = #j) ∧
 (∀ id sid1 sid2 sid3 #i id2 sid4 sid5 sid6 #j.
   (InvolvedServers( id, sid1, sid2, sid3 ) @ #i) ∧
   (InvolvedServers( id2, sid4, sid5, sid6 ) @ #j)
  ⇒
   (id = id2) ∧ (sid1 = sid4) ∧ (sid2 = sid5) ∧ (sid3 = sid6)) ∧
 (∃ id pw koprf kauth #i #j #k #l #m #n.
   (Secret( id, 'pw', pw ) @ #i) ∧
   (!KU( pw ) @ #j) ∧
   (Secret( id, 'koprf', koprf ) @ #k) ∧
   (!KU( koprf ) @ #l) ∧
   (Secret( id, 'kauth', kauth ) @ #m) ∧
   (!KU( kauth ) @ #n)
  ∧
   ∀ sid1 sid2 sid3 #o #p #q #r.
    (InvolvedServers( id, sid1, sid2, sid3 ) @ #o) ∧
    (!Compromised( sid1 ) @ #p) ∧
    (!Compromised( sid2 ) @ #q) ∧
    (!Compromised( sid3 ) @ #r)
   ⇒
    ⊥)"
*/
simplify
solve( Secret( id, 'pw', pw ) @ #i )
  case client_register
  solve( Client_0( $cid, ~pw ) ▶₀ #i )
    case client_initialise
    solve( !Server( $sid1 ) ▶₄ #i )
      case create_server
      solve( !Server( $sid2 ) ▶₅ #i )
        case create_server
        solve( !Server( $sid3 ) ▶₆ #i )
          case create_server
          solve( Secret( ~pw, 'koprf', koprf ) @ #k )
            case client_register
            solve( Client_0( $cid.1, ~pw ) ▶₀ #k )
              case client_initialise
              solve( Secret( ~pw, 'kauth', kauth ) @ #m )
                case client_register
                solve( Client_0( $cid.1, ~pw ) ▶₀ #m )
                  case client_initialise
                  solve( !KU( ~pw ) @ #j )
                    case bruteforce
                    solve( !KU( ~koprf1 ) @ #vk )
                      case eavesdrop_server
                      solve( !KU( ~koprf2 ) @ #vk.1 )
                        case eavesdrop_server
                        solve( !KU( ~koprf3 ) @ #vk.2 )
                          case eavesdrop_server
                          by contradiction /* from formulas */
                        next
                          case solve_dlog
                          solve( !KU( ~b ) @ #vk.3 )
                            case solve_dlog
                            solve( !KU( h(<~pw, mul((~koprf1++~koprf2++~koprf3), h(~pw))>)
                                   ) @ #n )
                              case c_h
                              solve( !KU( mul((~koprf1++~koprf2++~koprf3), h(~pw)) ) @ #vk.5 )
                                case adversary_recv_case_1
                                by sorry
                              next
                                case adversary_recv_case_2
                                by sorry
                              next
                                case adversary_recv_case_3
                                by sorry
                              next
                                case eavesdrop_server_case_1
                                by sorry
                              next
