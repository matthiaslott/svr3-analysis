           ) @ #j )
      case c_h
      by contradiction /* from formulas */
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    solve( !KU( h(<~pw, mul((~koprf1++~koprf2++~koprf3), h(~pw))>)
           ) @ #j.1 )
