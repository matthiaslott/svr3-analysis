lemma executability:
  exists-trace
  "(¬(∃ #i. AdversaryAction( ) @ #i)) ∧
   (∃ C S1 S2 S3 x y #i #j.
     (ClientInitialise( C, S1, S2, S3, x, y ) @ #i) ∧
     (ClientFinish( C, S1, S2, S3, x, y ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"(∀ #i. (AdversaryAction( ) @ #i) ⇒ ⊥) ∧
 (∃ C S1 S2 S3 x y #i #j.
   (ClientInitialise( C, S1, S2, S3, x, y ) @ #i) ∧
   (ClientFinish( C, S1, S2, S3, x, y ) @ #j))"
*/
simplify
  case 1
  solve( ClientEval( $C, $S1, $S2, $S3, ~x, ~b ) ▶₀ #j )
    case evaluate_client
    solve( !KU( mul((~b++~koprf1), h(~x)) ) @ #vk.6 )
      case c_mul
      by sorry
    next
      case evaluate_server_case_1
      solve( !KU( mul((~b++~koprf2), h(~x)) ) @ #vk.9 )
        case c_mul
        by sorry
      next
        case evaluate_server_case_1
        solve( !KU( mul((~b++~koprf3), h(~x)) ) @ #vk.12 )
          case c_mul
          by sorry
        next
          case evaluate_server_case_1
          solve( !KU( ~koprf1 ) @ #vk.23 )
            case bruteforce
            by contradiction /* from formulas */
          next
            case init_client
            solve( !KU( ~koprf2 ) @ #vk.29 )
              case bruteforce
              by contradiction /* from formulas */
            next
              case init_client
              solve( !KU( ~koprf3 ) @ #vk.34 )
                case bruteforce
                by contradiction /* from formulas */
              next
                case init_client
                solve( !KU( mul(~b, h(~x)) ) @ #vk.23 )
                  case c_mul
                  by sorry
                next
                  case evaluate_client_case_1
                  SOLVED // trace found
                next
                  case evaluate_client_case_2
                  SOLVED // trace found
                next
                  case evaluate_client_case_3
                  SOLVED // trace found
                next
                  case mul_up
                  by contradiction /* from formulas */
                qed
              qed
            qed
          qed
        next
          case evaluate_server_case_2
          by sorry
        next
          case mul_up_case_1
          by contradiction /* from formulas */
        next
          case mul_up_case_2
          by contradiction /* from formulas */
        next
          case mul_up_case_3
          by contradiction /* from formulas */
        next
          case mul_up_case_4
          by contradiction /* from formulas */
        next
          case mul_up_case_5
          by contradiction /* from formulas */
        qed
      next
        case evaluate_server_case_2
        by sorry
      next
        case mul_up_case_1
        by contradiction /* from formulas */
      next
        case mul_up_case_2
        by contradiction /* from formulas */
      next
        case mul_up_case_3
        by contradiction /* from formulas */
      next
        case mul_up_case_4
        by contradiction /* from formulas */
      next
        case mul_up_case_5
        by contradiction /* from formulas */
      qed
    next
      case evaluate_server_case_2
      by sorry
    next
      case mul_up_case_1
      by contradiction /* from formulas */
    next
      case mul_up_case_2
      by contradiction /* from formulas */
    next
      case mul_up_case_3
      by contradiction /* from formulas */
    next
      case mul_up_case_4
      by contradiction /* from formulas */
    next
      case mul_up_case_5
      by contradiction /* from formulas */
    qed
  qed
next
  case 2
  by sorry
next
  case 3
  by sorry
next
  case 4
  by sorry
next
  case 5
  by sorry
next
  case 6
  by sorry
qed

lemma mul_invariant [reuse, use_induction,
                     heuristic={mul_invariant}]:
  all-traces
  "∀ f x #i.
    (KMul( mul(f, h(x)) ) @ #i) ⇒
    (((∃ #k. BlindingFactor( f ) @ #k) ∨
      (∃ a b #k. (BlindingFactor( b ) @ #k) ∧ (f = (a++b)))) ∨
     (∃ #k. (!KU( x ) @ #k) ∧ (#k < #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ f x #i.
  (KMul( mul(f, h(x)) ) @ #i)
 ∧
  (∀ #k. (BlindingFactor( f ) @ #k) ⇒ ⊥) ∧
  (∀ a b #k. (BlindingFactor( b ) @ #k) ∧ (f = (a++b)) ⇒ ⊥) ∧
  (∀ #k. (!KU( x ) @ #k) ⇒ ¬(#k < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #k. (BlindingFactor( f ) @ #k) ∧ ¬(last(#k)))  ∥
         (∃ a b #k.
           (BlindingFactor( b ) @ #k) ∧ (f = (a++b)) ∧ ¬(last(#k)))  ∥
         (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #i)) )
    case case_1
    solve( KMul( mul(f, h(x)) ) @ #i )
      case add
      solve( !MulU( mul(b, h(x)) ) ▶₁ #i )
        case add
        solve( (∃ #k. (BlindingFactor( (b++~a.1) ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a.2 b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ ((b++~a.1) = (b.1++a.2))
                ∧
                 ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2_case_1
          by contradiction /* from formulas */
        next
          case case_2_case_2
          by contradiction /* from formulas */
        next
          case case_2_case_3
          by contradiction /* from formulas */
        next
          case case_2_case_4
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      next
        case combine
        solve( (∃ #k. (BlindingFactor( (b++a.1) ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a.2 b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ ((b++a.1) = (b.1++a.2))
                ∧
                 ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2_case_1
          by contradiction /* from formulas */
        next
          case case_2_case_2
          by contradiction /* from formulas */
        next
          case case_2_case_3
          by contradiction /* from formulas */
        next
          case case_2_case_4
          by contradiction /* from formulas */
        next
          case case_2_case_5
          by contradiction /* from formulas */
        next
          case case_2_case_6
          by contradiction /* from formulas */
        next
          case case_2_case_7
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      next
        case mul_coerce_case_1
        solve( (∃ #k. (BlindingFactor( b ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ (b = (a++b.1)) ∧ ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      next
        case mul_coerce_case_2
        solve( (∃ #k. (BlindingFactor( b ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ (b = (a++b.1)) ∧ ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      qed
    next
      case combine
      solve( !MulU( mul(b, h(x)) ) ▶₁ #i )
        case add
        solve( (∃ #k. (BlindingFactor( (b++~a.1) ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a.2 b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ ((b++~a.1) = (b.1++a.2))
                ∧
                 ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2_case_1
          by contradiction /* from formulas */
        next
          case case_2_case_2
          by contradiction /* from formulas */
        next
