                     (BlindingFactor( b ) @ #k) ∧ (a = (b++a.1)) ∧ ¬(last(#k)))  ∥
                   (∃ #k. (!KU( ~x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr.1)) )
              case case_1
