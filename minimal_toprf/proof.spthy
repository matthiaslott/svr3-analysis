lemma input_secrecy [heuristic={input_secrecy}]:
  all-traces
  "∀ C S1 S2 S3 x y #i.
    (ClientInitialise( C, S1, S2, S3, x, y ) @ #i) ⇒
    (¬(∃ #j. !KU( x ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ C S1 S2 S3 x y #i.
  (ClientInitialise( C, S1, S2, S3, x, y ) @ #i)
 ∧
  ∃ #j. (!KU( x ) @ #j)"
*/
simplify
solve( !KU( ~x ) @ #j )
  case bruteforce
  solve( !KU( h(~x) ) @ #vk )
    case c_h
    by contradiction /* cyclic */
  next
    case extract_case_1
    solve( (∃ #k. (BlindingFactor( a ) @ #k))  ∥
           (∃ a.1 b #k. (BlindingFactor( b ) @ #k) ∧ (a = (b++a.1)))  ∥
           (∃ #k. (!KU( ~x ) @ #k) ∧ #k < #vr.1) )
      case case_1
      solve( !KU( ~b.1 ) @ #vk.1 )
        case bruteforce
        solve( !KU( h(~b) ) @ #vk.3 )
          case c_h
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_2
      solve( !KU( ~b.1 ) @ #vk.4 )
        case bruteforce
        solve( !KU( h(~b) ) @ #vk.5 )
          case c_h
          by contradiction /* cyclic */
        qed
      qed
    next
      case case_3
      by contradiction /* cyclic */
    qed
  next
    case extract_case_2
    solve( (∃ #k. (BlindingFactor( a ) @ #k))  ∥
           (∃ a.1 b #k. (BlindingFactor( b ) @ #k) ∧ (a = (b++a.1)))  ∥
           (∃ #k. (!KU( ~x ) @ #k) ∧ #k < #vr.1) )
      case case_1
