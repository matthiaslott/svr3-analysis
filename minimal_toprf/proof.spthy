                 (∃ a.1 b.1 #k.
                   (BlindingFactor( b.1 ) @ #k) ∧ ((a++b) = (a.1++b.1))
                  ∧
                   ¬(last(#k)))  ∥
                 (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr.2)) )
            case case_1
            by contradiction /* from formulas */
