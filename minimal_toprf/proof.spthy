        solve( (∃ #k. (BlindingFactor( b ) @ #k) ∧ ¬(last(#k)))  ∥
               (∃ a b.1 #k.
                 (BlindingFactor( b.1 ) @ #k) ∧ (b = (a++b.1)) ∧ ¬(last(#k)))  ∥
               (∃ #k. (!KU( x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr)) )
          case case_1
          by contradiction /* from formulas */
        next
          case case_2
          by contradiction /* from formulas */
        next
          case case_3
          by contradiction /* from formulas */
        qed
      qed
    next
      case evaluate_server
      solve( !Initialised( $C, $Si, koprfi ) ▶₁ #i )
        case init_server
        solve( !KU( mul(factors, h(x)) ) @ #vk.6 )
          case c_mul
          solve( !KU( h(x) ) @ #vk.9 )
            case c_h
            by contradiction /* from formulas */
          next
            case extract_case_1
            solve( (∃ #k. (BlindingFactor( a ) @ #k) ∧ ¬(last(#k)))  ∥
                   (∃ a.1 b #k.
                     (BlindingFactor( b ) @ #k) ∧ (a = (b++a.1)) ∧ ¬(last(#k)))  ∥
                   (∃ #k. (!KU( ~x ) @ #k) ∧ (¬(last(#k))) ∧ (#k < #vr.1)) )
              case case_1
              solve( !KU( ~b.1 ) @ #vk.10 )
                case bruteforce
                solve( !KU( h(~b.1) ) @ #vk.12 )
                  case c_h
                  by contradiction /* cyclic */
                qed
              qed
            next
              case case_2
