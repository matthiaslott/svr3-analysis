theory TOPRF

begin

builtins: hashing, multiset

tactic: sources
prio:
  regex "SourceP"
prio:
  regex "!MulU\(" | regex "!KU\( mul\("

tactic: mul_invariant
prio:
  regex "!KU\( ~b" | regex "!KU\( h\(~b"
prio:
  regex "BlindingFactor"
prio:
  regex "!MulU\( mul\(b, h\(x\)\)"

tactic: input_secrecy
prio:
  regex "!KU\( ~b" | regex "!KU\( h\(~b"



predicates:
    DISTINCT(x, y, z) <=> not (x = y | x = z | y = z)


// Multiplication

functions:
    mul/2 // scalar multiplication

rule mul_down[no_derivcheck, color=#d66f7c]:
    [ In(mul(f, x)) ]-->[ !MulD(mul(f, x)) ]

rule mul_coerce[no_derivcheck, color=#d66f7c]: // similar to coerce rule (KD -> KU)
    [ !MulD(mul(f, x)) ]--[ KMul(mul(f, x)) ]->[ !MulU(mul(f, x)) ]

rule mul_up[no_derivcheck, color=#d66f7c]:
    [ !MulU(mul(f, x)) ]-->[ Out(mul(f, x)) ]

// Construction Rules
rule combine[no_derivcheck, color=#d66f7c]: // [a]x, [b]x -> [a+b]x
    [ !MulU(mul(a, x)), !MulU(mul(b, x)) ]
  --[ KMul(mul(a ++ b, x))
    , SourcesPoint(x)
    , AdversaryAction() ]->
    [ !MulU(mul(a ++ b, x)) ]

rule add[no_derivcheck, color=#d66f7c]: // a, [b]x -> [a*b]x
    [ In(~a), !MulU(mul(b, x)) ]
  --[ KMul(mul(~a ++ b, x))
    , SourcesPoint(x)
    , AdversaryAction() ]->
    [ !MulU(mul(~a ++ b, x)) ]

// Deconstruction Rules
rule remove[no_derivcheck, color=#d66f7c]: // a, [a*b]x -> [b]x
    [ In(a), !MulD(mul(a ++ b, x)) ]
  --[ KMul(mul(b, x))
    , SourcesPoint(x)
    , AdversaryAction() ]->
    [ !MulD(mul(b, x)) ]

rule extract[no_derivcheck, color=#d66f7c]: // a, [a]x -> x
    [ In(a), !MulD(mul(a, x)) ]
  --[ KMul(mul(a, x))
    , SourcesPoint(x)
    , AdversaryAction() ]->
    [ Out(x) ]


// Bruteforce

rule bruteforce[no_derivcheck]: // Simplification of brute-force attacks that works only on hashes
    [ In(h(~x)) ]
  --[ AdversaryAction() ]->
    [ Out(~x) ] 


// Server Compromise

rule compromise:
    [ !Initialised($C, $Si, koprfi) ]
  --[ Compromised($Si)
    , AdversaryAction() ]->
    [ Out(koprfi) ]


// TOPRF

// Assumptions:
// - Client remembers with which servers it initialised
// - Use a slightly abnormal setup where the TOPRF input x is already known during initialisation (like in SVR3). 

// Initialisation
rule init_client:
    let
      y = h(~x, mul(~koprf1 ++ ~koprf2 ++ ~koprf3, h(~x)))
    in
    [ Fr(~x), Fr(~koprf1), Fr(~koprf2), Fr(~koprf3) ]
  --[ _restrict(DISTINCT($S1, $S2, $S3))
    , ClientInitialise($C, $S1, $S2, $S3, ~x, y) ]->
    [ !ClientInit($C, $S1, $S2, $S3, ~x), Out(<$C, $S1, ~koprf1>), Out(<$C, $S2, ~koprf2>), Out(<$C, $S3, ~koprf3>) ]

rule init_server:
    [ In(<$C, $Si, koprfi>) ]
  --[ ]->
    [ !Initialised($C, $Si, koprfi) ] 


// Evaluation
rule evaluate_client:
    let
      blinded_hash = mul(~b, h(~x)) 
    in
    [ !ClientInit($C, $S1, $S2, $S3, ~x), Fr(~b) ]
  --[ ClientEvaluate($C, $S1, $S2, $S3, ~x)
    , SourceP(h(~x))
    , BlindingFactor(~b) ]->
    [ ClientEval($C, $S1, $S2, $S3, ~x, ~b), Out(<$C, $S1, blinded_hash>), Out(<$C, $S2, blinded_hash>), Out(<$C, $S3, blinded_hash>) ]

rule evaluate_server[no_derivcheck]:
    let
      blinded_hash = mul(factors, hx)
    in
    [ In(<$C, $Si, blinded_hash>), !Initialised($C, $Si, koprfi) ]
  --[ SourcesPoint(hx)
    , KMul(mul(factors ++ koprfi, hx)) ]->
    [ Out(<$C, $Si, mul(factors ++ koprfi, hx)>) ]
  
rule evaluate_finish[no_derivcheck]:
    let
      part1 = mul(~b ++ koprf1, hx) // Note: Also here, we make the assumption that the generators are the same!
      part2 = mul(~b ++ koprf2, hx)
      part3 = mul(~b ++ koprf3, hx)
      y = h(~x, mul(koprf1 ++ koprf2 ++ koprf3, hx))
    in
    [ ClientEval($C, $S1, $S2, $S3, ~x, ~b), In(<$C, $S1, part1>), In(<$C, $S2, part2>), In(<$C, $S3, part3>) ]
  --[ ClientFinish($C, $S1, $S2, $S3, ~x, y) ]->
    [ ]


lemma types[sources,heuristic={sources}]:
    "(All p #i.
      SourcesPoint(p)@#i
      ==>
      ( (Ex #j. SourceP(p)@#j & #j < #i)
      | (Ex #j. !KU(p)@#j & #j < #i)
      )
    )"


lemma executability:
    exists-trace "
      // adversary doesn't do anything
      not (Ex #i. AdversaryAction()@#i)
      &
      ( Ex C S1 S2 S3 x y #i #j.
          ( ClientInitialise(C, S1, S2, S3, x, y)@#i
          & ClientFinish(C, S1, S2, S3, x, y)@#j
        )
      )
    "

lemma mul_invariant[reuse,use_induction,heuristic={mul_invariant}]:
    "All f x #i. KMul(mul(f, h(x)))@#i // & (Ex #j. !HumanGenerated(pw)@#j) // If multiplication with a password hash on the right side, then
      ==> (Ex #k. BlindingFactor(f)@#k) // f contains a secret factor
      | (Ex a b #k. BlindingFactor(b)@#k & f = a ++ b) // f contains a secret factor
      | (Ex #k. !KU(x)@#k & #k < #i)" // don't want to deal with the case where adversary knows the password already
  
lemma input_secrecy[heuristic={input_secrecy}]:
    "All C S1 S2 S3 x y #i.
      ClientInitialise(C, S1, S2, S3, x, y)@#i
        ==> (not Ex #j. KU(x)@#j)
    "
